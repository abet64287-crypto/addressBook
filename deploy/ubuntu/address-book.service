[Unit]
Description=Address Book application
After=network.target

[Service]
Type=simple
User=addressbook
Group=addressbook
WorkingDirectory=/opt/address-book
Environment=ADDRESSBOOK_DATABASE=/var/lib/addressbook/contacts.sqlite3
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# Only local requests from Caddy's HTTPS site reach this service.
# The external scheme keeps the application's Origin check correct.
ExecStart=/opt/address-book/.venv/bin/waitress-serve --listen=127.0.0.1:8001 --url-scheme=https --threads=2 --connection-limit=32 --max-request-body-size=10485760 run:app
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/addressbook

[Install]
WantedBy=multi-user.target
